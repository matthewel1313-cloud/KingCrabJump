 "control_hz": 200,
 "modes_used": {
  "claw_left": "jumper.five_foot: walks on five legs, carries the left claw; LT closes it. Entered with LB.",
  "dance_dream_wings": "recorded-motion dance, both claws up. Entered with menu + d-pad right.",
  "locomotion": "jumper.posture: the start-up mode (the hook's look-up is entered from here, LB is pressed at t=0)."
 },
 "pad_vocabulary": {
  "Lx / Ly": "walk sideways / forward (ly < 0 is forward; 0.15 deadband)",
  "Rx": "first half twists the body in place, beyond 0.5 walks a turn",
  "Ry": "> 0 nose up (look up / offer a held tool up), < 0 nose down",
  "LT": "close the left claw",
  "LB": "toggle claw_left",
  "menu + dpad_right": "dance_dream_wings"
 },
