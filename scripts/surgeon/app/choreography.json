  {
   "beat": "hook",
   "pad": "LB tap; Ry +0.9 (look up at camera), release"
  },
  {
   "beat": "scalpel",
   "pad": "closed-loop Lx/Ly to the handle; LT 0.85; weld+seat; back off; Ry +0.45; Rx -0.45 (twist to surgeon); glove takes it; LT 0; Ry/Rx 0"
  },
  {
   "beat": "forceps",
   "pad": "same, shorter ramps and waits"
  },
  {
   "beat": "scissors",
   "pad": "stops at the gauze first: grasp; Ry +0.7 lift; Rx -0.42/+0.42 'hm?'; place back; LT 0; then the scissors as above"
  },
  {
   "beat": "faster",
   "pad": "Lx at full deflection to the gauze; same grasp/present, shortest waits"
  },
  {
   "beat": "perfect",
   "pad": "menu + d-pad right -> dance_dream_wings"
  }
 ],
